# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=8000

# PostgreSQL (e.g. Supabase's session pooler URL)
DATABASE_URI=postgresql://user:password@host:5432/postgres

# Session tokens: long random strings, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_a_long_random_string
JWT_REFRESH_SECRET=replace_with_another_long_random_string
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=3d

# Sign-up / sign-in rate limits
MAX_FAILED_LOGIN_ATTEMPTS_SIGNIN=5
LOCKOUT_DURATION_MINUTES_SIGNIN=15
MAX_FAILED_LOGIN_ATTEMPTS_SIGNUP=5
LOCKOUT_DURATION_MINUTES_SIGNUP=15

# Back-office callers (loan approval, payout, underwriting queue)
INTERNAL_API_KEY=replace_with_a_long_random_string

# Encrypts TOTP 2FA secrets at rest: exactly 64 hex characters
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TWO_FACTOR_ENCRYPTION_KEY=

# "Ask VergePay": the assistant's own small model runs in the API (downloaded
# once into ASSISTANT_MODEL_CACHE). An open chat model is optional: point
# OLLAMA_URL at an Ollama server (e.g. http://localhost:11434) with the model
# pulled (ollama pull qwen2.5:3b) to have answers reworded more naturally.
ASSISTANT_EMBEDDING_MODEL=Xenova/bge-small-en-v1.5
ASSISTANT_MODEL_CACHE=./.model-cache
OLLAMA_URL=
OLLAMA_MODEL=qwen2.5:3b

# Flutterwave v3 (test mode keys: FLWSECK_TEST-..., FLWPUBK_TEST-...)
FLW_SECRET_KEY=
FLW_PUBLIC_KEY=
# The "secret hash" you set in the Flutterwave dashboard's webhook settings
FLW_SECRET_HASH=
# Where checkout returns the customer; saved-card charges need a public https URL
FLW_REDIRECT_URL=https://your-public-host.example/dashboard/payments/complete

# Redis for the BullMQ job queue (e.g. a free Upstash database: rediss://default:...@....upstash.io:6379)
REDIS_URL=

# Encrypts brokerage OAuth tokens in the vault: exactly 64 hex characters
VAULT_ENCRYPTION_KEY=

# Alpaca OAuth app (dashboard: Connect -> My Developed Apps); paper accounts are free
ALPACA_CLIENT_ID=
ALPACA_CLIENT_SECRET=
# Must match the redirect URI registered on the Alpaca app
ALPACA_REDIRECT_URI=http://localhost:8000/v1/brokerage-links/oauth/callback
# paper (default) or live
ALPACA_ENV=paper

# Testing only (ignored when NODE_ENV=production): link every user to one
# shared paper account instead of their own via OAuth, e.g. while the OAuth
# app awaits Alpaca's approval. Uses that account's API keys (dashboard ->
# API Keys; the secret is shown only when the keys are generated).
ALPACA_SHARED_ACCOUNT=false
ALPACA_PAPER_KEY_ID=
ALPACA_PAPER_SECRET=

# Identity verification: sandbox (default outside production) decides test
# submissions itself: BVN 00000000000 is rejected, 11111111111 rejected for a
# name mismatch, anything else approved. In production, set a real provider;
# until then submissions stay pending for review.
KYC_PROVIDER=
KYC_SANDBOX_DELAY_MS=
